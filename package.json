{
	"name": "portfolio",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && node scripts/postbuild.ts",
		"preview": "wrangler dev --config dist/server/wrangler.json",
		"check": "astro check && vp check",
		"test": "vp test",
		"test:e2e": "playwright test",
		"lint": "vp check",
		"format": "vp check --fix",
		"deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.2.1",
		"@inlang/paraglide-js": "^2.23.1",
		"astro": "^7.2.2",
		"temporal-polyfill": "^1.0.3"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"esbuild": "^0.28.2",
		"typescript": "^6.0.3",
		"vite-plus": "^0.2.9",
		"vitest": "^4.1.10",
		"wrangler": "^4.125.0"
	},
	"engines": {
		"node": ">=26.6.0"
	},
	"packageManager": "pnpm@11.9.0"
}
