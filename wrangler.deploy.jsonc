// Config for the Cloudflare-side build, which runs `pnpm build` itself instead
// of consuming the wrangler.json the Astro adapter generates. Every runtime
// detail (bindings, cron schedules, the entry point) has to be repeated here;
// keep it in step with wrangler.jsonc.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	// Built by scripts/postbuild.ts, which explains why the adapter's own entry
	// will not do; it is the only entry that exports `scheduled`.
	"main": "dist/server/worker.mjs",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": ["nodejs_compat"],
	"build": {
		"command": "pnpm build",
	},
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": ["**/*.js", "**/*.mjs"],
		},
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "dist/client",
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
		},
		{
			"binding": "GITHUB_CACHE",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio",
			"migrations_dir": "migrations",
		},
	],
	// Drives the refresh in src/lib/scheduled.ts, which is where the cadence is explained.
	"triggers": {
		"crons": ["0 */12 * * *"],
	},
}
