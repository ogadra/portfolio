// Config for the Cloudflare-side build, which runs `pnpm build` itself instead
// of consuming the wrangler.json the Astro adapter generates. Every runtime
// detail (bindings, cron schedules, the entry point) has to be repeated here;
// keep it in step with wrangler.jsonc.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	// scripts/postbuild.mjs drops this wrapper next to entry.mjs; it is the only
	// entry that exports `scheduled`, which the cron trigger below needs.
	"main": "dist/server/worker.mjs",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": ["nodejs_compat"],
	"build": {
		"command": "pnpm build",
	},
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": ["**/*.js", "**/*.mjs"],
		},
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "dist/client",
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
		},
		{
			"binding": "GITHUB_CACHE",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio",
			"database_id": "df0a57fd-43ed-45d4-b099-14a37d464e2b",
			"migrations_dir": "migrations",
		},
	],
	// Refresh the persisted daily commit history twice a day so each day is
	// captured before it rolls out of the GitHub commit-search window.
	"triggers": {
		"crons": ["0 */12 * * *"],
	},
}
