---
import { env } from 'cloudflare:workers';
import HudShell from '../components/HudShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveGithubStats } from '../lib/homeStats';

const { cfContext } = Astro.locals;

const stats = await resolveGithubStats(env, (promise) => cfContext.waitUntil(promise));
---

<BaseLayout>
	<HudShell stats={stats} />
</BaseLayout>
