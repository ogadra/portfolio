---
import { getLocale } from '../paraglide/runtime.js';
import BootOverlay from '../components/BootOverlay.astro';
import '../styles/global.css';
import criticalCss from './BaseLayout.critical.css?raw';

interface Props {
	title?: string;
}

const { title = 'ogadra.com' } = Astro.props;
---

<!doctype html>
<html lang={getLocale()}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link
			rel="preload"
			href="/fonts/Oswald-Medium.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<style is:inline set:html={criticalCss}></style>
	</head>
	<body>
		<BootOverlay />
		<div class="content-root">
			<slot />
		</div>
	</body>
</html>

<style>
	@import './BaseLayout.css';
</style>
