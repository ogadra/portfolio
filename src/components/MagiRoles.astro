---
import type { LanguageShare } from '../lib/github';
import { m } from '../paraglide/messages.js';

interface Props {
	languages: LanguageShare[];
}

const { languages } = Astro.props;

const units = [
	{ code: 'UNIT-01', name: m.unit_frontend(), tech: 'TypeScript', accent: 'cyan' },
	{ code: 'UNIT-02', name: m.unit_backend(), tech: 'Go', accent: 'orange' },
	{ code: 'UNIT-03', name: m.unit_infrastructure(), tech: 'HCL', accent: 'green' },
];

const shareFor = (tech: string) => languages.find((l) => l.name === tech)?.ratio ?? null;
---

<aside class="magi" id="skills">
	<p class="magi-title">
		<span class="nerv-section-label">{m.skills_head_en()}</span>
		<span class="magi-jp">{m.skills_head_jp()}</span>
	</p>
	{
		units.map((u) => {
			const share = shareFor(u.tech);
			return (
				<div class={`unit ${u.accent}`}>
					<div class="unit-head">
						<div class="name-box">
							<span class="reg">{m.skill_register()}</span>
							<p class="unit-name">{u.name}</p>
						</div>
						<span class="unit-badge">{u.code}</span>
					</div>
					<div class="rows">
						<div class="row">
							<span>{m.skill_primary_lang()}</span>
							<b>{u.tech}</b>
						</div>
						<div class="row">
							<span>{m.skill_github_share()}</span>
							<b class="num">
								{share === null ? '--' : `${share}%`}
								{share === null ? <i class="na">{m.value_na()}</i> : <i class="ok">{m.value_ok()}</i>}
							</b>
						</div>
						<div class="row">
							<span>{m.skill_status()}</span>
							<b class="verdict">{m.skill_status_value()}</b>
						</div>
					</div>
					{share !== null && (
						<div class="meter" aria-hidden="true">
							<span class="meter-fill" style={`width:${share}%`} />
						</div>
					)}
				</div>
			);
		})
	}
</aside>

<style>
	@import './MagiRoles.css';
</style>
