---
import HexField from '../assets/hexField.svg';

const BLIPS = [
	{ x: 22, y: 34, tone: 'cyan', delaySec: 0 },
	{ x: 78, y: 26, tone: 'orange', delaySec: 1.3 },
	{ x: 66, y: 72, tone: 'cyan', delaySec: 2.1 },
	{ x: 34, y: 78, tone: 'orange', delaySec: 0.7 },
	{ x: 88, y: 58, tone: 'cyan', delaySec: 3.2 },
];
---

<div class="nerv-background" aria-hidden="true">
	<HexField class="hex-layer" />

	<div class="rings"></div>
	<div class="sweep"></div>

	<div class="blips">
		{
			BLIPS.map((b) => (
				<span
					class={b.tone}
					style={`left:${b.x}%; top:${b.y}%; animation-delay:${b.delaySec}s`}
				/>
			))
		}
	</div>

	<div class="guide" style="left: 12%"></div>
	<div class="guide" style="left: 50%"></div>
	<div class="guide" style="left: 88%"></div>
</div>

<script>
	// the authored coordinates only cover the first pass; re-placing the blip on
	// each fade-out keeps the contacts from settling into a fixed pattern
	const rand = (min: number, max: number) => min + Math.random() * (max - min);
	const place = (el: HTMLElement) => {
		el.style.left = `${rand(6, 94)}%`;
		el.style.top = `${rand(8, 92)}%`;
	};
	for (const el of document.querySelectorAll<HTMLElement>('.blips span')) {
		el.addEventListener('animationiteration', () => place(el));
	}
</script>

<style>
	@import './NervBackground.css';
</style>
