---
import BootReticle from './svg/BootReticle.astro';
---

<div id="boot" aria-hidden="true">
	<span class="boot-corner tl"></span>
	<span class="boot-corner tr"></span>
	<span class="boot-corner bl"></span>
	<span class="boot-corner br"></span>

	<div class="boot-inner">
		<BootReticle />

		<div class="boot-readout">
			<span class="boot-status">SYSTEM STARTUP</span>
			<span class="boot-pct"><span data-boot-pct>000</span>%</span>
		</div>
		<div class="boot-progress"><span class="boot-progress-fill"></span></div>

		<ul class="boot-log">
			<li style="animation-delay: 0.15s">GITHUB LINK ........... OK</li>
			<li style="animation-delay: 0.4s">COMMIT HISTORY ........ OK</li>
			<li style="animation-delay: 0.65s">HUD RENDER ............ OK</li>
		</ul>
	</div>
</div>

<script is:inline>
	(() => {
		const el = document.getElementById('boot');
		const pct = el && el.querySelector('[data-boot-pct]');
		if (!el || !pct) {
			throw new Error('boot overlay markup is missing #boot or [data-boot-pct]');
		}
		let v = 0;
		const timer = setInterval(() => {
			v = Math.min(100, v + Math.ceil(Math.random() * 14));
			pct.textContent = String(v).padStart(3, '0');
			if (v >= 100) clearInterval(timer);
		}, 80);
		// the overlay can leave before the counter reaches 100, so stop the timer
		// with it rather than waiting for the counter to finish on a detached node
		const remove = () => {
			clearInterval(timer);
			el.remove();
		};
		el.addEventListener('animationend', (e) => {
			if (e.target === el && e.animationName === 'boot-out') remove();
		});
		setTimeout(remove, 2500);
	})();
</script>

<style is:global>
	#boot .boot-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	#boot .boot-readout {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		width: 220px;
	}
	#boot .boot-status {
		font-family: 'Monaspace', 'Courier New', monospace;
		font-size: 0.65rem;
		letter-spacing: 0.3em;
		color: #ff9900;
		animation: boot-blink 0.8s step-end infinite;
	}
	#boot .boot-pct {
		font-family: 'Monaspace', 'Courier New', monospace;
		font-size: 0.65rem;
		letter-spacing: 0.15em;
		font-variant-numeric: tabular-nums;
		color: #e3ddd4;
	}

	#boot .boot-progress {
		width: 220px;
		height: 2px;
		background: rgba(255, 153, 0, 0.12);
		overflow: hidden;
		margin-top: -0.5rem;
	}
	#boot .boot-progress-fill {
		display: block;
		width: 100%;
		height: 100%;
		background: #ff9900;
		transform: scaleX(0);
		transform-origin: left;
		animation: boot-progress 0.9s steps(12, end) 0.1s forwards;
	}

	#boot .boot-log {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	#boot .boot-log li {
		font-family: 'Monaspace', 'Courier New', monospace;
		font-size: 0.58rem;
		letter-spacing: 0.2em;
		color: #e3ddd4;
		opacity: 0;
		animation: boot-flicker-in 0.25s step-end forwards;
	}

	#boot .boot-corner {
		position: absolute;
		width: 28px;
		height: 28px;
		border: 0 solid #ff9900;
		opacity: 0;
		animation: boot-flicker-in 0.3s step-end forwards;
	}
	#boot .tl {
		top: 12px;
		left: 12px;
		border-top-width: 2px;
		border-left-width: 2px;
		animation-delay: 0.1s;
	}
	#boot .tr {
		top: 12px;
		right: 12px;
		border-top-width: 2px;
		border-right-width: 2px;
		animation-delay: 0.2s;
	}
	#boot .br {
		bottom: 12px;
		right: 12px;
		border-bottom-width: 2px;
		border-right-width: 2px;
		animation-delay: 0.3s;
	}
	#boot .bl {
		bottom: 12px;
		left: 12px;
		border-bottom-width: 2px;
		border-left-width: 2px;
		animation-delay: 0.4s;
	}

	@keyframes boot-progress {
		to {
			transform: scaleX(1);
		}
	}
	@keyframes boot-blink {
		0%,
		60% {
			opacity: 1;
		}
		61%,
		100% {
			opacity: 0.25;
		}
	}
</style>
