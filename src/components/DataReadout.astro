---
import { ACTIVITY_DAYS, type GithubStats } from '../lib/github';
import { m } from '../paraglide/messages.js';

interface Props {
	stats: GithubStats | null;
}

const { stats } = Astro.props;

const daily = stats?.dailyCommits ?? Array.from({ length: ACTIVITY_DAYS }, () => 0);
const maxDaily = Math.max(1, ...daily);
const bars = daily.map((count) => ({
	height: count === 0 ? 4 : Math.max(14, Math.round((count / maxDaily) * 100)),
	active: count > 0,
}));
/** Reads the stored instant as `MM/DD HH:MM`, keeping the UTC the API reports. */
const stamp = (occurredAt: string): string =>
	`${occurredAt.slice(5, 10).replace('-', '/')} ${occurredAt.slice(11, 16)}`;

const logText = stats?.log.map((l) => `${stamp(l.occurredAt)} ${l.label}`).join('\n');
---

<aside class="readout">
	<div class="block nerv-panel" id="activity">
		<p class="block-head">
			<span class="nerv-section-label">{m.activity_head_en()}</span>
			<span class="head-jp">{m.activity_head_jp()}</span>
		</p>
		<p class="count-value">
			<span data-count={stats?.recentCommits}>{stats?.recentCommits ?? '--'}</span>
			<small>{m.activity_unit({ days: ACTIVITY_DAYS })}</small>
		</p>
		<div class="wave" aria-hidden="true">
			{
				bars.map((b, i) => (
					<span
						class={b.active ? 'on' : 'off'}
						style={`height:${b.height}%; animation-delay:${i * 60}ms`}
					/>
				))
			}
		</div>
		<p class="wave-caption">
			{m.activity_caption({ days: ACTIVITY_DAYS })}
			{stats ? '' : ` ${m.activity_caption_offline()}`}
		</p>
	</div>

	<div class="block nerv-panel" id="languages">
		<p class="block-head">
			<span class="nerv-section-label">{m.languages_head_en()}</span>
			<span class="head-jp">{m.languages_head_jp()}</span>
		</p>
		{
			stats && stats.languages.length > 0 ? (
				stats.languages.slice(0, 3).map((lang, i) => (
					<div class="gauge">
						<span class="gauge-label">{lang.name}</span>
						<span class="gauge-meter">
							<span
								class="gauge-fill"
								style={`width:${lang.ratio}%; animation-delay:${i * 150}ms`}
							/>
						</span>
						<span class="gauge-note">{lang.ratio}%</span>
					</div>
				))
			) : (
				<p class="offline">{m.data_link_offline()}</p>
			)
		}
	</div>

	<div class="block nerv-panel" id="log">
		<p class="block-head">
			<span class="nerv-section-label">{m.log_head_en()}</span>
			<span class="head-jp">{m.log_head_jp()}</span>
		</p>
		{
			stats && logText ? (
				<div class="log-window">
					<div class="log-scroll" style={`--log-lines:${stats.log.length}`}>
						<pre>{logText}</pre>
						<pre aria-hidden="true">{logText}</pre>
					</div>
				</div>
			) : (
				<p class="offline">{m.data_link_offline()}</p>
			)
		}
	</div>
</aside>

<script>
	const el = document.querySelector<HTMLElement>('[data-count]');
	const target = Number(el?.dataset.count);
	if (el && Number.isFinite(target)) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			el.textContent = String(target);
		} else {
			let current = 0;
			const step = Math.max(1, Math.ceil(target / 12));
			const timer = setInterval(() => {
				current = Math.min(target, current + Math.ceil(Math.random() * step));
				el.textContent = String(current);
				if (current >= target) clearInterval(timer);
			}, 70);
		}
	}
</script>

<style>
	@import './DataReadout.css';
</style>
