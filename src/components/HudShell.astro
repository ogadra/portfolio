---
import type { GithubStats } from '../lib/github';
import CommandBar from './CommandBar.astro';
import DataReadout from './DataReadout.astro';
import MagiRoles from './MagiRoles.astro';
import NervBackground from './NervBackground.astro';
import StatusTicker from './StatusTicker.astro';
import SubjectDisplay from './SubjectDisplay.astro';

interface Props {
	stats: GithubStats | null;
}

const { stats } = Astro.props;
---

<div class="hud-root">
	<NervBackground />
	<span class="corner tl" aria-hidden="true"></span>
	<span class="corner tr" aria-hidden="true"></span>
	<span class="corner bl" aria-hidden="true"></span>
	<span class="corner br" aria-hidden="true"></span>

	<CommandBar />
	<main class="hud-main">
		<DataReadout stats={stats} />
		<SubjectDisplay stats={stats} />
		<MagiRoles languages={stats?.languages ?? []} />
	</main>
	<StatusTicker stats={stats} />
</div>

<script>
	// pin the radar/rings centre to the subject reticle, measured relative to this
	// scrolling HUD root so the background stays aligned as the page scrolls
	const root = document.querySelector<HTMLElement>('.hud-root');
	const stage = document.querySelector<HTMLElement>('.subject .stage');
	if (!root || !stage) {
		throw new Error('cannot align the radar: .hud-root or .subject .stage is missing');
	}
	const alignRadar = () => {
		const r = root.getBoundingClientRect();
		const s = stage.getBoundingClientRect();
		root.style.setProperty('--radar-cx', `${s.left + s.width / 2 - r.left}px`);
		root.style.setProperty('--radar-cy', `${s.top + s.height / 2 - r.top}px`);
	};
	alignRadar();
	requestAnimationFrame(alignRadar);
	// browser zoom (Cmd/Ctrl +/-) reflows the layout without firing resize on
	// every step, so watch the elements themselves instead
	const ro = new ResizeObserver(alignRadar);
	ro.observe(root);
	ro.observe(stage);
	window.addEventListener('resize', alignRadar);
	window.addEventListener('load', alignRadar);
</script>

<style>
	@import './HudShell.css';
</style>
