---
// The targeting reticle the boot overlay draws itself around. Each ring flickers
// or sweeps in on its own delay, so the assembly reads as an instrument coming
// up rather than a static graphic.
import { radialTicks } from '../../lib/reticle';

const ticks = radialTicks({
	center: 100,
	count: 36,
	radius: 82,
	outerRadius: 88,
	mainRadius: 74,
	mainEvery: 9,
});
const cardinals = radialTicks({
	center: 100,
	count: 4,
	radius: 92,
	outerRadius: 104,
	mainRadius: 92,
	mainEvery: 1,
});
---

<svg class="reticle" viewBox="0 0 200 200" width="220" height="220">
	<circle
		class="ring-outer"
		cx="100"
		cy="100"
		r="94"
		fill="none"
		stroke="#ff9900"
		stroke-width="1.5"
		stroke-dasharray="8 4"></circle>
	<circle class="ring-static" cx="100" cy="100" r="88" fill="none" stroke="#ff9900"></circle>
	<g class="ticks" stroke="#ff9900" stroke-width="1">
		{ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
	</g>
	<g class="cardinals" stroke="#ff9900" stroke-width="2">
		{cardinals.map((c) => <line x1={c.x1} y1={c.y1} x2={c.x2} y2={c.y2} />)}
	</g>
	<circle class="ring-inner" cx="100" cy="100" r="62" fill="none" stroke="#ff9900" stroke-width="1"
	></circle>
	<circle
		class="ring-core"
		cx="100"
		cy="100"
		r="30"
		fill="none"
		stroke="#ff9900"
		stroke-width="1"
		stroke-dasharray="3 6"></circle>
	<g class="crosshair" stroke="#ff9900" stroke-width="1">
		<line x1="100" y1="70" x2="100" y2="130"></line>
		<line x1="70" y1="100" x2="130" y2="100"></line>
	</g>
	<circle class="core-dot" cx="100" cy="100" r="2.5" fill="#ff9900"></circle>
</svg>

<style>
	.reticle {
		overflow: visible;
		filter: drop-shadow(0 0 5px rgba(255, 153, 0, 0.4));
	}

	.ring-outer {
		opacity: 0;
		transform-origin: 100px 100px;
		animation:
			boot-flicker-in 0.4s step-end 0.1s forwards,
			reticle-rotate 6s linear infinite;
	}
	.ring-static {
		opacity: 0;
		animation: boot-flicker-in 0.3s step-end 0.2s forwards;
	}
	.ring-inner {
		stroke-dasharray: 390;
		stroke-dashoffset: 390;
		animation: reticle-draw 0.5s steps(9, end) forwards;
	}
	.ring-core {
		opacity: 0;
		transform-origin: 100px 100px;
		animation:
			boot-flicker-in 0.3s step-end 0.5s forwards,
			reticle-rotate-rev 9s linear infinite;
	}
	.ticks {
		opacity: 0;
		animation: boot-flicker-in 0.4s step-end 0.25s forwards;
	}
	.cardinals {
		opacity: 0;
		animation: boot-flicker-in 0.3s step-end 0.35s forwards;
	}
	.crosshair {
		opacity: 0;
		animation: boot-flicker-in 0.3s step-end 0.45s forwards;
	}
	.core-dot {
		opacity: 0;
		animation: reticle-blink-in 0.3s step-end 0.6s forwards;
	}

	@keyframes reticle-blink-in {
		to {
			opacity: 1;
		}
	}
	@keyframes reticle-rotate {
		to {
			transform: rotate(1turn);
		}
	}
	@keyframes reticle-rotate-rev {
		to {
			transform: rotate(-1turn);
		}
	}
	@keyframes reticle-draw {
		to {
			stroke-dashoffset: 0;
		}
	}
</style>
