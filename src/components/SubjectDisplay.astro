---
import SubjectReticle from '../assets/subjectReticle.svg';
import type { GithubStats } from '../lib/github';
import { m } from '../paraglide/messages.js';

interface Props {
	stats: GithubStats | null;
}

const { stats } = Astro.props;
---

<section class="subject" id="subject">
	<div class="stage">
		<SubjectReticle class="reticle" aria-hidden="true" />
		<img
			class="icon"
			src="/imgs/ogadra.png"
			alt={m.welcome_icon_alt()}
			width="3000"
			height="3300"
		/>
	</div>
	<div class="identity">
		<p class="eyebrow" aria-hidden="true">
			<span class="eyebrow-en">{m.subject_eyebrow_en()}</span>
			<span class="eyebrow-jp">{m.subject_eyebrow_jp()}</span>
		</p>
		<h1>OGADRA</h1>
		<p class="classification">{m.subject_classification()}</p>
		<div class="stat-boxes" aria-hidden="true">
			<div class="stat orange">
				<span class="stat-label">{m.stat_public_repos()}</span>
				<span class="stat-value">{stats?.publicRepos ?? '--'}</span>
			</div>
			<div class="stat cyan">
				<span class="stat-label">{m.stat_followers()}</span>
				<span class="stat-value">{stats?.followers ?? '--'}</span>
			</div>
			<div class="stat green">
				<span class="stat-label">{m.stat_status()}</span>
				<span class="stat-value">{stats ? m.status_nominal() : m.status_offline()}</span>
			</div>
		</div>
	</div>
</section>

<style is:global>
	@import './SubjectDisplay.css';
</style>
