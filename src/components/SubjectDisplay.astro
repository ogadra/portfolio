---
import SubjectReticle from '../assets/subjectReticle.svg';
import type { GithubStats } from '../lib/github';
import { PROFILE } from '../lib/profile';
import { m } from '../paraglide/messages.js';

interface Props {
	stats: GithubStats | null;
}

const { stats } = Astro.props;

// Instrument readout, not localisable copy: kept out of the message catalogue.
const EYEBROW = { en: 'Subject Identification', jp: '開発者識別' };
const STATS = { repos: 'Public Repos', followers: 'Followers', status: 'Status' };
---

<section id="subject">
	<div class="stage">
		<SubjectReticle class="reticle" aria-hidden="true" />
		<img
			class="icon"
			src="/imgs/ogadra.png"
			alt={m.welcome_icon_alt()}
			width="3000"
			height="3300"
		/>
	</div>
	<div class="identity">
		<p class="eyebrow" aria-hidden="true">
			<span class="eyebrow-en">{EYEBROW.en}</span>
			<span class="eyebrow-jp">{EYEBROW.jp}</span>
		</p>
		<h1>OGADRA</h1>
		<p class="classification">CLASSIFICATION // {PROFILE.role}</p>
		<div class="stat-boxes" aria-hidden="true">
			<div class="stat orange">
				<span class="stat-label">{STATS.repos}</span>
				<span class="stat-value">{stats?.publicRepos ?? '--'}</span>
			</div>
			<div class="stat cyan">
				<span class="stat-label">{STATS.followers}</span>
				<span class="stat-value">{stats?.followers ?? '--'}</span>
			</div>
			<div class="stat green">
				<span class="stat-label">{STATS.status}</span>
				<span class="stat-value">{stats ? 'NOMINAL' : 'OFFLINE'}</span>
			</div>
		</div>
	</div>
</section>

<style is:global>
	@import './SubjectDisplay.css';
</style>
